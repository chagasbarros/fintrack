<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Tela principal. Pode ser aberta e editada visualmente no Scene Builder. -->
<!-- fx:controller liga este arquivo a classe que trata os eventos e os dados -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.fintrack.controller.PrincipalController"
            styleClass="raiz">

    <!-- Topo: titulo e saldo -->
    <top>
        <VBox spacing="4" styleClass="cabecalho">
            <Label text="FinTrack" styleClass="titulo"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Saldo atual:" styleClass="rotulo-saldo"/>
                <Label fx:id="lblSaldo" text="R$ 0,00" styleClass="saldo"/>
            </HBox>
        </VBox>
    </top>

    <!-- Centro: tabela de transacoes -->
    <center>
        <TableView fx:id="tabela">
            <columns>
                <TableColumn fx:id="colData" text="Data" prefWidth="110"/>
                <TableColumn fx:id="colDescricao" text="Descricao" prefWidth="380"/>
                <TableColumn fx:id="colValor" text="Valor" prefWidth="140" styleClass="coluna-valor"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110"/>
            </columns>
            <BorderPane.margin>
                <Insets top="12" bottom="12"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <!-- Base: botoes de acao -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="btnNova" text="Nova transacao" styleClass="botao-principal"/>
            <Button fx:id="btnEditar" text="Editar">
                <tooltip><Tooltip text="Tambem e possivel editar com duplo clique na linha"/></tooltip>
            </Button>
            <Button fx:id="btnRemover" text="Remover" styleClass="botao-perigo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRelatorio" text="Relatorio"/>
        </HBox>
    </bottom>
</BorderPane>
